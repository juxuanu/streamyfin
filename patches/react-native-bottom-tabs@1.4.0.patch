+  /// Position of a tab bar item among the rendered tabs, in declaration order.
+  ///
+  /// `tabBar.items` comes back in display order, which stops being the declaration order as soon as
+  /// UIKit moves a tab: an app linked against the iOS 27 SDK gets its search tab last. Reading the tab
+  /// by the item's own index then puts every label after the moved tab on the wrong item, so the item
+  /// is matched to its tab by identity instead.
+  private func declarationIndex(of item: UITabBarItem, at tabBarIndex: Int, in tabBar: UITabBar) -> Int {
+    if #available(iOS 18.0, tvOS 18.0, visionOS 2.0, *),
+      let tabController = tabBar.delegate as? UITabBarController,
+      let index = tabController.tabs.firstIndex(where: { $0.viewController?.tabBarItem === item })
+    {
+      return index
+    }
+
+    return tabBarIndex
+  }
