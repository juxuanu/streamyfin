@@ -35,6 +35,13 @@ public enum TabBarRole: String {
   func convert() -> TabRole {
     switch self {
     case .search:
+      #if compiler(>=6.4) && os(iOS)
+        // An app linked against the iOS 27 SDK gets its search tab inline, at the end of the bar.
+        // The detached trailing button a search tab had on iOS 26 is the prominent role there.
+        if #available(iOS 27.0, *) {
+          return .prominent
+        }
+      #endif
       return .search
     }
   }
